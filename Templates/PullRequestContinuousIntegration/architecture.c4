// Pull Request Continuous Integration, after AWS's reference architecture:
// https://docs.aws.amazon.com/reference-architecture-diagrams/latest/pull-request-continuous-integration/pull-request-continuous-integration.html
// Systems and users are slots in the project's architecture.
model {
  developer = user 'Developer' {
    description 'Opens or updates a pull request and reviews its CI status.'
  }

  github = system 'GitHub' {
    description 'Third-party Git provider; pull request webhooks trigger CodeBuild and receive CI status updates.'
    technology 'GitHub'
  }
  bitbucket = system 'Bitbucket' {
    description 'Alternative third-party Git provider; pull request webhooks trigger CodeBuild and receive CI status updates.'
    technology 'Bitbucket'
  }

  aws = zone 'AWS' {
    metadata {
      platform 'aws'
    }

    codecommit = platform 'AWS CodeCommit' {
      description 'AWS-hosted Git source alternative; a Lambda trigger handles its pull request events.'
      metadata {
        uses 'aws-codecommit'
      }
    }
    codebuild = platform 'AWS CodeBuild' {
      description 'Receives Git-provider pull request webhooks, archives source, and supports CI build and test work.'
      metadata {
        uses 'aws-codebuild'
      }
    }
    lambda = platform 'AWS Lambda' {
      metadata {
        uses 'aws-lambda'
      }
      codecommitTrigger = system 'CodeCommit trigger' {
        description 'Starts the CodeBuild path for CodeCommit pull request events.'
      }
      queueConsumer = system 'Pull request queue consumer' {
        description 'Checks prerequisites, starts CI, copies source to Pipeline Source, and removes obsolete queued versions of updated pull requests.'
      }
      statusReporter = system 'CI status reporter' {
        description 'Reports stage progress, failure, or success to the selected Git provider.'
      }
    }
    s3 = platform 'Amazon S3' {
      metadata {
        uses 'amazon-s3'
      }
      gitArtifactsBucket = database 'Git Artifacts bucket' {
        description 'Stores pull request source archives produced by CodeBuild.'
      }
      pipelineSourceBucket = database 'Pipeline Source bucket' {
        description 'Stores source copied by the queue consumer for the CI stages.'
      }
    }
    readyQueue = platform 'Amazon SQS' {
      description 'Backlog of pull requests ready for CI.'
      metadata {
        uses 'amazon-sqs'
      }
    }
    apiGateway = platform 'Amazon API Gateway' {
      description 'Coordinates validation, unit testing, artifact build, preview environment creation, and integration/end-to-end tests.'
      metadata {
        uses 'amazon-api-gateway'
      }
    }
    eventBridge = platform 'Amazon EventBridge' {
      description 'Tracks changes between CI stages and routes them for status reporting.'
      metadata {
        uses 'amazon-eventbridge'
      }
    }
  }

  developer -> github 'Opens or updates pull requests in'
  developer -> bitbucket 'Alternatively opens or updates pull requests in'
  github -> aws.codebuild 'Sends pull request webhooks to'
  bitbucket -> aws.codebuild 'Alternatively sends pull request webhooks to'
  aws.codecommit -> aws.lambda.codecommitTrigger 'Provides pull request events to'
  aws.lambda.codecommitTrigger -> aws.codebuild 'Triggers'
  aws.codebuild -> aws.s3.gitArtifactsBucket 'Archives pull request source in'
  aws.codebuild -> aws.readyQueue 'Enqueues a ready message in'
  aws.readyQueue -> aws.lambda.queueConsumer 'Delivers ready messages to'
  aws.lambda.queueConsumer -> aws.s3.gitArtifactsBucket 'Reads archived source from'
  aws.lambda.queueConsumer -> aws.s3.pipelineSourceBucket 'Copies source into'
  aws.lambda.queueConsumer -> aws.readyQueue 'Removes obsolete queued versions of updated pull requests from'
  aws.lambda.queueConsumer -> aws.apiGateway 'Starts CI coordination through'
  aws.apiGateway -> aws.codebuild 'Coordinates validation, unit testing, artifact build, and integration/end-to-end test work with'
  aws.eventBridge -> aws.lambda.statusReporter 'Routes stage changes to'
  aws.lambda.statusReporter -> github 'Reports progress, failure, or success to'
  aws.lambda.statusReporter -> bitbucket 'Alternatively reports progress, failure, or success to'
}

views {
  view index {
    title 'Pull Request Continuous Integration'
    include *, aws.*
  }
}
