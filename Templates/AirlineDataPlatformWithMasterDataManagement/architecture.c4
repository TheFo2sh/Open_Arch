// Airline Data Platform with Master Data Management, after AWS's reference architecture:
// https://docs.aws.amazon.com/reference-architecture-diagrams/latest/airlines-data-platform-mdm/airlines-data-platform-mdm.html
// Read together with the repository's specification.c4. Systems and users are slots.
model {
  airlineSystems = system 'Airline systems of record' {
    description 'Operational, passenger-service, loyalty, baggage, booking, and survey systems that supply airline and customer data.'
  }
  externalData = system 'External data sources' {
    description 'External demographic and address data sources used to enrich customer records.'
  }
  mdmService = system 'Third-party MDM service' {
    description 'Vendor-neutral slot for the MDM tool and interface that identifies and deduplicates customer records.'
  }
  apiClients = system 'Airline API clients' {
    description 'Mobile customer-service apps, customer-service dashboards, websites, and mobile apps that call customer-facing APIs.'
  }
  analyticsConsumers = system 'Customer analytics consumers' {
    description 'Airline systems and teams consuming customer-centric analytics and data products.'
  }
  dashboardUser = user 'Dashboard user' {
    description 'Uses customer analytics dashboards.'
  }

  aws = zone 'AWS Cloud' {
    metadata {
      platform 'aws'
    }

    kinesis = platform 'Amazon Kinesis' {
      description 'Ingests real-time operational and customer events.'
      metadata {
        uses 'amazon-kinesis'
      }
    }
    s3 = platform 'Amazon S3' {
      description 'Data lake for real-time and batch staging, Parquet conversions, and reportable datasets.'
      metadata {
        uses 'amazon-s3'
      }
      dataLake = database 'Airline data lake' {
        description 'Stores flight, passenger, loyalty, baggage, demographic, address, and customer-centric datasets.'
      }
    }
    transferFamily = platform 'AWS Transfer Family' {
      description 'Batch file ingestion path into the data lake.'
      metadata {
        uses 'aws-transfer-family'
      }
    }
    dataExchange = platform 'AWS Data Exchange' {
      description 'Ingestion path for external data products.'
      metadata {
        uses 'aws-data-exchange'
      }
    }
    appFlow = platform 'Amazon AppFlow' {
      description 'Managed ingestion path from connected external data sources.'
      metadata {
        uses 'amazon-appflow'
      }
    }
    emr = platform 'Amazon EMR' {
      description 'Managed data processing for lake transformations.'
      metadata {
        uses 'amazon-emr'
      }
      emrJobs = system 'Airline data transformation jobs' {
        description 'Batch jobs that transform and convert airline datasets.'
      }
    }
    glue = platform 'AWS Glue' {
      description 'Runs ML transforms for customer identification and deduplication and provides the data catalog.'
      metadata {
        uses 'aws-glue'
      }
      dataCatalog = database 'AWS Glue Data Catalog' {
        description 'Catalog of data lake tables and schemas.'
      }
    }
    dynamodb = platform 'Amazon DynamoDB' {
      description 'Customer 360 profile store and source of the customer change stream.'
      metadata {
        uses 'amazon-dynamodb'
      }
      customerProfiles = database 'Customer 360 profiles' {
        description 'Customer-centric profiles enhanced with matched and deduplicated loyalty and traveler records.'
      }
    }
    stepFunctions = platform 'AWS Step Functions' {
      description 'Orchestrates customer-centric microservices and complex event processing.'
      metadata {
        uses 'aws-step-functions'
      }
    }
    lambda = platform 'AWS Lambda' {
      description 'Serverless functions used in customer event processing.'
      metadata {
        uses 'aws-lambda'
      }
      eventFunctions = system 'Customer event functions' {
        description 'Functions that process customer events as part of the Step Functions workflows.'
      }
    }
    fargate = platform 'AWS Fargate' {
      description 'Serverless container compute used in customer event processing.'
      metadata {
        uses 'aws-fargate'
      }
      eventTasks = system 'Customer event tasks' {
        description 'Container tasks that process customer events as part of the Step Functions workflows.'
      }
    }
    apiGateway = platform 'Amazon API Gateway' {
      description 'API entry point for airline customer-facing applications.'
      metadata {
        uses 'amazon-api-gateway'
      }
    }
    redshift = platform 'Amazon Redshift' {
      description 'Enterprise data warehouse and customer-centric data marts.'
      metadata {
        uses 'amazon-redshift'
      }
      customerMarts = database 'Customer data marts' {
        description 'Customer-centric domain schemas and analytics marts.'
      }
    }
    sagemaker = platform 'Amazon SageMaker AI' {
      description 'Builds customer analysis and machine learning models.'
      metadata {
        uses 'amazon-sagemaker-ai'
      }
      customerAnalysis = system 'Customer analysis models' {
        description 'Models for customer segmentation and lifetime value.'
      }
    }
    athena = platform 'Amazon Athena' {
      description 'Queries data lake datasets for ad hoc analysis.'
      metadata {
        uses 'amazon-athena'
      }
    }
    quickSight = platform 'Amazon QuickSight' {
      description 'Customer analytics dashboards.'
      metadata {
        uses 'amazon-quicksight'
      }
    }
  }

  airlineSystems -> aws.kinesis 'Publishes real-time airline and customer events to'
  mdmService -> aws.kinesis 'Publishes matched customer events to'
  externalData -> aws.dataExchange 'Supplies external data through'
  externalData -> aws.appFlow 'Supplies connected-source data through'
  airlineSystems -> aws.transferFamily 'Supplies batch files through'
  aws.kinesis -> aws.s3.dataLake 'Stages real-time events in'
  aws.transferFamily -> aws.s3.dataLake 'Loads batch files into'
  aws.dataExchange -> aws.s3.dataLake 'Loads external datasets into'
  aws.appFlow -> aws.s3.dataLake 'Loads connected-source datasets into'
  aws.s3.dataLake -> aws.emr.emrJobs 'Provides datasets for transformation to'
  aws.emr.emrJobs -> aws.s3.dataLake 'Writes converted and reportable datasets to'
  aws.s3.dataLake -> aws.glue 'Provides datasets for ML transforms and cataloging to'
  aws.glue -> aws.dynamodb.customerProfiles 'Writes matched and deduplicated customer profiles to'
  aws.dynamodb.customerProfiles -> aws.stepFunctions 'Publishes a change stream to'
  aws.stepFunctions -> aws.lambda.eventFunctions 'Orchestrates event processing with'
  aws.stepFunctions -> aws.fargate.eventTasks 'Orchestrates event processing with'
  apiClients -> aws.apiGateway 'Calls customer-facing APIs through'
  aws.apiGateway -> aws.stepFunctions 'Routes requests to customer-centric microservices in'
  aws.stepFunctions -> aws.dynamodb.customerProfiles 'Reads and updates customer profiles in'
  aws.stepFunctions -> worldTracer 'Publishes baggage reconciliation events to'
  aws.stepFunctions -> customerEventSubscribers 'Publishes customer events to'
  aws.s3.dataLake -> aws.athena 'Makes lake datasets available for ad hoc queries through'
  aws.s3.dataLake -> aws.sagemaker.customerAnalysis 'Provides data for customer analysis to'
  aws.redshift.customerMarts -> aws.sagemaker.customerAnalysis 'Provides customer data marts to'
  aws.redshift.customerMarts -> aws.quickSight 'Provides customer analytics data to'
  aws.athena -> aws.quickSight 'Provides queried data for customer analytics to'
  aws.quickSight -> analyticsConsumers 'Publishes customer analytics to'
  dashboardUser -> analyticsConsumers 'Uses'

  customerEventSubscribers = system 'Customer event subscribers' {
    description 'Downstream consumers of published customer-centric events.'
  }
  worldTracer = system 'WorldTracer NetTracer' {
    description 'External baggage reconciliation event consumer named by the AWS diagram.'
  }

}

views {
  view index {
    title 'Airline Data Platform with Master Data Management'
    include *, aws.*
  }
}
