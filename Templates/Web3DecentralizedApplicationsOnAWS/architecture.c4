// Web3 Decentralized Applications on AWS:
// https://docs.aws.amazon.com/reference-architecture-diagrams/latest/web3-decentralized-applications-on-aws/web3-decentralized-applications-on-aws.html
// Systems and users are slots. The AWS source does not specify the DApp framework or blockchain node provider.
model {
  dappUser = user 'DApp user' {
    description 'Uses the browser-hosted decentralized application.'
  }

  ethereum = zone 'Ethereum Mainnet' {
    metadata {
      platform 'other'
    }

    mainnet = platform 'Ethereum Blockchain Mainnet' {
      description 'External decentralized Ethereum network that propagates requests and returns blockchain responses.'
      metadata {
        uses 'ethereum-mainnet'
      }
    }
  }

  aws = zone 'AWS' {
    metadata {
      platform 'aws'
    }

    cloudfront = platform 'Amazon CloudFront' {
      description 'Serves the DApp at the closest edge distribution and retrieves its static files from S3.'
      metadata {
        uses 'amazon-cloudfront'
      }
    }
    s3 = platform 'Amazon S3' {
      metadata {
        uses 'amazon-s3'
      }
      dappFiles = database 'Static DApp files' {
        description 'Stores the browser application; access is restricted to the configured CloudFront origin access identity.'
      }
    }
    frontend = system 'DApp frontend' {
      description 'The static browser application; map this slot to the project frontend system.'

      browserApp = container 'Browser application' {
        description 'Runs in a browser after CloudFront delivers its static files.'
      }
    }
    apiGateway = platform 'Amazon API Gateway' {
      description 'Receives browser API requests and routes them to the DApp backend.'
      metadata {
        uses 'amazon-api-gateway'
      }
    }
    lambda = platform 'AWS Lambda' {
      description 'Runs the request-handling backend described in the AWS source.'
      metadata {
        uses 'aws-lambda'
      }

      backend = system 'DApp backend' {
        description 'The backend system slot that handles API path and method requests.'

        requestHandler = container 'Web3 request handler' {
          description 'Binds request paths and methods into Web3.js requests and signs HTTP requests with SigV4.'
          metadata {
            uses 'web3-js, aws-signature-version-4'
          }
        }
      }
    }
    vpc = platform 'Amazon Virtual Private Cloud' {
      description 'Boundary shown around the Amazon Managed Blockchain Ethereum node.'
      metadata {
        uses 'amazon-vpc'
      }

      managedBlockchain = platform 'Amazon Managed Blockchain Ethereum node' {
        description 'Receives and processes Web3 requests from the DApp backend.'
        metadata {
          uses 'amazon-managed-blockchain'
        }
      }
    }
  }

  dappUser -> aws.frontend 'Uses'
  aws.frontend -> aws.cloudfront 'Loads the static application from'
  aws.cloudfront -> aws.s3.dappFiles 'Fetches the application files from'
  aws.frontend.browserApp -> aws.apiGateway 'Sends API requests to'
  aws.apiGateway -> aws.lambda.backend 'Routes requests to'
  aws.lambda.backend.requestHandler -> aws.vpc.managedBlockchain 'Sends signed Web3 requests to'
  aws.vpc.managedBlockchain -> ethereum.mainnet 'Propagates Ethereum requests to and receives responses from'
}

views {
  view index {
    title 'Web3 Decentralized Applications on AWS'
    include *, aws.*, aws.frontend.*, aws.lambda.*, aws.lambda.backend.*, aws.vpc.*, ethereum.*
  }
}
