// Run Machine Learning Algorithms with Satellite Data, after AWS's reference architecture:
// https://docs.aws.amazon.com/reference-architecture-diagrams/latest/ml-satellite-data/ml-satellite-data.html
// Systems are slots mapped onto the project's own when the template is applied.
model {
  satellite = system 'Satellite' {
    description 'External source that transmits data and imagery to the AWS Ground Station antenna; the satellite provider is not specified.'
  }

  aws = zone 'AWS Cloud' {
    metadata {
      platform 'aws'
    }

    groundStation = platform 'AWS Ground Station' {
      description 'Provides antenna control, contact scheduling, and demodulation or error correction; delivers satellite data as baseband or digitized RF-over-IP.'
      metadata {
        uses 'aws-ground-station'
      }
    }

    ec2 = platform 'Amazon EC2' {
      description 'Runs the instance that receives and processes the Ground Station data.'
      metadata {
        uses 'amazon-ec2'
      }

      receiver = system 'Satellite data processor' {
        description 'Receives and processes baseband or digitized RF-over-IP data, then stores satellite imagery in Amazon S3.'
      }
    }

    s3 = platform 'Amazon Simple Storage Service' {
      description 'Stores satellite imagery at ingestion and labeled imagery for training.'
      metadata {
        uses 'amazon-s3'
      }

      ingestedImagery = database 'Ingested satellite imagery' {
        description 'Imagery processed by the Amazon EC2 instance and stored for notebook preparation and event-triggered inference.'
      }
      labeledImagery = database 'Labeled training imagery' {
        description 'Labeled image data retained in Amazon S3 and used to train the machine-learning model.'
      }
    }

    dataPreparation = system 'Data preparation notebooks' {
      description 'Jupyter notebooks that ingest satellite imagery from Amazon S3 and prepare it for training.'
      technology 'Jupyter Notebook'
    }

    groundTruth = platform 'Amazon SageMaker Ground Truth' {
      description 'Labels satellite images for machine-learning training.'
      metadata {
        uses 'amazon-sagemaker-ground-truth'
      }
    }

    trainingNotebooks = system 'Training notebooks' {
      description 'Jupyter notebooks that hold the training algorithm and code.'
      technology 'Jupyter Notebook'
    }

    sagemaker = platform 'Amazon SageMaker AI' {
      description 'Runs the training algorithm, trains models, and deploys model endpoints.'
      metadata {
        uses 'amazon-sagemaker-ai'
      }

      training = system 'Satellite imagery model training' {
        description 'Trains a machine-learning model using the algorithm and labeled imagery.'
      }
      endpoint = system 'Satellite imagery inference endpoint' {
        description 'Processes satellite images and produces inference results and metadata.'
      }
    }

    lambda = platform 'AWS Lambda' {
      description 'Automatically invokes machine-learning processing when new image data arrives in Amazon S3.'
      metadata {
        uses 'aws-lambda'
      }

      inferenceTrigger = system 'S3-triggered inference function' {
        description 'Runs for new satellite imagery in Amazon S3 and invokes the SageMaker model endpoint.'
      }
    }

    dynamodb = platform 'Amazon DynamoDB' {
      description 'Stores the inference output and metadata generated by the model endpoint.'
      metadata {
        uses 'amazon-dynamodb'
      }

      results = database 'Inference results and metadata' {
        description 'Model inference outputs and associated metadata.'
      }
    }

    amplify = platform 'AWS Amplify' {
      description 'Provides the application access path to the machine-learning algorithm and database.'
      metadata {
        uses 'aws-amplify'
      }

      applications = system 'User applications' {
        description 'Applications that use AWS Amplify to access the machine-learning algorithm and inference database; application details are not specified.'
      }
    }
  }

  satellite -> aws.groundStation 'Transmits imagery and data to'
  aws.groundStation -> aws.ec2.receiver 'Delivers baseband or digitized RF-over-IP data to'
  aws.ec2.receiver -> aws.s3.ingestedImagery 'Processes and stores imagery in'
  aws.s3.ingestedImagery -> aws.dataPreparation 'Provides imagery to prepare for training in'
  aws.dataPreparation -> aws.groundTruth 'Submits images for labeling with'
  aws.groundTruth -> aws.s3.labeledImagery 'Stores labeled imagery in'
  aws.s3.labeledImagery -> aws.trainingNotebooks 'Provides labeled imagery to'
  aws.trainingNotebooks -> aws.sagemaker.training 'Provides the training algorithm and code to'
  aws.sagemaker.training -> aws.sagemaker.endpoint 'Deploys the trained model to'
  aws.s3.ingestedImagery -> aws.lambda.inferenceTrigger 'Automatically triggers on new image data in'
  aws.lambda.inferenceTrigger -> aws.sagemaker.endpoint 'Invokes machine-learning processing on'
  aws.sagemaker.endpoint -> aws.dynamodb.results 'Stores inference results and metadata in'
  aws.amplify.applications -> aws.sagemaker.endpoint 'Accesses the machine-learning algorithm through AWS Amplify'
  aws.amplify.applications -> aws.dynamodb.results 'Accesses the inference database through AWS Amplify'
}

views {
  view index {
    title 'Run Machine Learning Algorithms with Satellite Data'
    include *, aws.*
  }
}
