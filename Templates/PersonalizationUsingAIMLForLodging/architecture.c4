// Personalization Using AI/ML for Lodging, after AWS's reference architecture:
// https://docs.aws.amazon.com/reference-architecture-diagrams/latest/personalization-ai-ml-lodging/personalization-ai-ml-lodging.html
// Systems and users are slots. The AWS source does not name its MDM provider.
model {
  systemsOfRecord = system 'Lodging systems of record' {
    description 'Property management, reservation, point-of-sale, loyalty, booking, and survey systems that supply lodging and guest data.'
  }
  externalData = system 'External data sources' {
    description 'External sources of demographic and address data.'
  }
  mdm = system 'Third-party master data management integration' {
    description 'Vendor-neutral slot for the MDM integration that unifies guest profiles across systems of record.'
  }
  customerApps = system 'Lodging customer applications' {
    description 'Mobile customer-service apps, customer-service dashboards, websites, and mobile customer apps that call customer-facing APIs.'
  }
  propertySubscribers = system 'Property systems and other subscribers' {
    description 'Downstream lodging systems and subscribers receiving published customer events.'
  }
  guestChannels = system 'Guest communication channels' {
    description 'Guest-facing phone, email, messaging, push, voice, or in-app channels.'
  }
  analyticsDashboard = system 'Customer analytics dashboard' {
    description 'Dashboard through which lodging teams access customer analytics.'
  }
  guest = user 'Lodging guest' {
    description 'Receives operational communications and personalized lodging offers on preferred channels.'
  }
  dashboardUser = user 'Dashboard user' {
    description 'Uses customer analytics dashboards.'
  }

  aws = zone 'AWS Cloud' {
    metadata {
      platform 'aws'
    }

    s3 = platform 'Amazon S3' {
      description 'Data lake foundation for raw, staged, curated, reportable, and interaction datasets.'
      metadata {
        uses 'amazon-s3'
      }
      dataLake = database 'Lodging data lake' {
        description 'Stores reservation, stay, folio, ancillary, property, loyalty, demographic, address, survey, campaign, interaction, and customer analytics datasets.'
      }
    }
    kinesis = platform 'Amazon Kinesis Data Streams' {
      description 'Ingests real-time lodging and customer events.'
      metadata {
        uses 'amazon-kinesis-data-streams'
      }
    }
    transferFamily = platform 'AWS Transfer Family' {
      description 'Batch-file ingestion path from lodging systems of record.'
      metadata {
        uses 'aws-transfer-family'
      }
    }
    dataExchange = platform 'AWS Data Exchange' {
      description 'Ingestion path for external data products.'
      metadata {
        uses 'aws-data-exchange'
      }
    }
    appFlow = platform 'Amazon AppFlow' {
      description 'Managed integration path from connected lodging data sources.'
      metadata {
        uses 'amazon-appflow'
      }
    }
    glue = platform 'AWS Glue' {
      description 'Processes and transforms raw and curated data lake content.'
      metadata {
        uses 'aws-glue'
      }
    }
    glueCatalog = platform 'AWS Glue Data Catalog' {
      description 'Catalog of data lake tables and schemas.'
      metadata {
        uses 'aws-glue-data-catalog'
      }
      lakeCatalog = database 'Data lake catalog' {
        description 'Metadata catalog for data lake datasets.'
      }
    }
    emr = platform 'Amazon EMR' {
      description 'Managed data processing for lake transformations.'
      metadata {
        uses 'amazon-emr'
      }
      transformJobs = system 'Data lake transformation jobs' {
        description 'Jobs that transform raw data into curated and reportable datasets.'
      }
    }
    personalize = platform 'Amazon Personalize' {
      description 'Creates guest segmentations, target lists, and personalized lodging offers from data lake content.'
      metadata {
        uses 'amazon-personalize'
      }
    }
    pinpoint = platform 'Amazon Pinpoint' {
      description 'Delivers operational communications and personalized offers across guest channels and records delivery interactions.'
      metadata {
        uses 'amazon-pinpoint'
      }
    }
    dynamodb = platform 'Amazon DynamoDB' {
      description 'Customer 360 profile store; its change stream feeds customer event processing.'
      metadata {
        uses 'amazon-dynamodb'
      }
      customer360 = database 'Customer 360 data' {
        description 'Unified guest profiles used by customer-facing services and event processing.'
      }
    }
    apiGateway = platform 'Amazon API Gateway' {
      description 'API entry point for lodging customer-facing applications.'
      metadata {
        uses 'amazon-api-gateway'
      }
    }
    stepFunctions = platform 'AWS Step Functions' {
      description 'Orchestrates customer event processing, customer microservices, and complex event processing.'
      metadata {
        uses 'aws-step-functions'
      }
    }
    lambda = platform 'AWS Lambda' {
      description 'Serverless functions used in customer event processing.'
      metadata {
        uses 'aws-lambda'
      }
      eventFunctions = system 'Customer event functions' {
        description 'Functions that process customer events in Step Functions workflows.'
      }
    }
    fargate = platform 'AWS Fargate' {
      description 'Serverless container compute used in customer event processing.'
      metadata {
        uses 'aws-fargate'
      }
      eventTasks = system 'Customer event tasks' {
        description 'Container tasks that process customer events in Step Functions workflows.'
      }
    }
    redshift = platform 'Amazon Redshift' {
      description 'Customer data marts for lodging analytics.'
      metadata {
        uses 'amazon-redshift'
      }
      customerMarts = database 'Customer data marts' {
        description 'Customer-centric data prepared for analytics.'
      }
    }
    athena = platform 'Amazon Athena' {
      description 'Queries data lake datasets for customer analytics.'
      metadata {
        uses 'amazon-athena'
      }
    }
    sagemaker = platform 'Amazon SageMaker AI' {
      description 'Builds custom customer analysis and machine learning models from raw and curated data lake content.'
      metadata {
        uses 'amazon-sagemaker-ai'
      }
      customerModels = system 'Customer analysis models' {
        description 'Models for customer lifetime value, segmentation, and specialized offers.'
      }
    }
    quickSight = platform 'Amazon QuickSight' {
      description 'Customer analytics and dashboards for lodging business users.'
      metadata {
        uses 'amazon-quicksight'
      }
    }
  }

  systemsOfRecord -> aws.kinesis 'Publishes real-time lodging and customer events to'
  mdm -> aws.kinesis 'Publishes MDM events to'
  systemsOfRecord -> aws.transferFamily 'Supplies batch files through'
  systemsOfRecord -> aws.appFlow 'Supplies connected-source data through'
  externalData -> aws.dataExchange 'Supplies external datasets through'
  aws.kinesis -> aws.s3.dataLake 'Stages real-time events in'
  aws.kinesis -> aws.stepFunctions 'Routes customer events to event processing in'
  aws.transferFamily -> aws.s3.dataLake 'Loads batch files into'
  aws.dataExchange -> aws.s3.dataLake 'Loads external datasets into'
  aws.appFlow -> aws.s3.dataLake 'Loads connected-source datasets into'
  aws.s3.dataLake -> aws.glue 'Provides raw and curated data for processing to'
  aws.s3.dataLake -> aws.emr.transformJobs 'Provides data for transformation to'
  aws.emr.transformJobs -> aws.s3.dataLake 'Writes transformed and reportable datasets to'
  aws.glue -> aws.glueCatalog 'Catalogs data lake datasets in'
  aws.s3.dataLake -> aws.personalize 'Provides data for guest segmentation and offers to'
  aws.personalize -> aws.pinpoint 'Provides personalized offers for delivery through'
  aws.dynamodb.customer360 -> aws.stepFunctions 'Publishes customer changes through its change stream to'
  aws.apiGateway -> aws.stepFunctions 'Routes customer API requests to microservices in'
  aws.stepFunctions -> aws.lambda.eventFunctions 'Orchestrates event processing with'
  aws.stepFunctions -> aws.fargate.eventTasks 'Orchestrates event processing with'
  aws.stepFunctions -> aws.dynamodb.customer360 'Reads and updates guest profiles in'
  aws.stepFunctions -> propertySubscribers 'Publishes customer events to'
  aws.pinpoint -> guestChannels 'Delivers operational communications and offers through'
  aws.pinpoint -> aws.s3.dataLake 'Records campaigns, delivery status, and guest interactions in'
  aws.s3.dataLake -> aws.sagemaker.customerModels 'Provides raw and curated data for model development to'
  aws.sagemaker.customerModels -> aws.s3.dataLake 'Writes reportable model results to'
  aws.s3.dataLake -> aws.redshift.customerMarts 'Supplies data for customer data marts in'
  aws.s3.dataLake -> aws.athena 'Makes datasets available for queries through'
  aws.redshift.customerMarts -> aws.quickSight 'Provides customer analytics data to'
  aws.athena -> aws.quickSight 'Provides queried data for analytics to'
  aws.quickSight -> analyticsDashboard 'Publishes customer analytics to'
  customerApps -> aws.apiGateway 'Calls customer-facing APIs through'
  guest -> guestChannels 'Receives communications through'
  dashboardUser -> analyticsDashboard 'Uses'
}

views {
  view index {
    title 'Personalization Using AI/ML for Lodging'
    include *, aws.*
  }
}
