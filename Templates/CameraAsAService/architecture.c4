// Camera as a Service, after AWS's reference architecture
// (https://docs.aws.amazon.com/reference-architecture-diagrams/latest/camera-as-a-service/camera-as-a-service.html).
// AWS does not specify the image-extraction feature's implementation or where it runs.
model {
  camera = system 'IoT-enabled camera' {
    description 'Generates a live video feed and publishes it using the Kinesis Video Streams Producer Libraries.'
    metadata {
      uses 'amazon-kinesis-video-streams-producer-libraries'
    }
  }
  endUser = user 'End user' {
    description 'Consumes the live video feed and machine-learning inference through APIs.'
  }

  aws = zone 'AWS' {
    metadata {
      platform 'aws'
    }

    kinesis = platform 'Amazon Kinesis Video Streams' {
      description 'Ingests camera video feeds and supplies live media to the user application.'
      metadata {
        uses 'amazon-kinesis-video-streams'
      }
    }
    s3 = platform 'Amazon Simple Storage Service' {
      description 'Stores images extracted from the live video feed.'
      metadata {
        uses 'amazon-s3'
      }
      images = database 'Extracted video images' {
        description 'Images sent for machine-learning inference.'
      }
    }
    lambda = platform 'AWS Lambda' {
      description 'Runs when an image is written to Amazon S3 and sends that image to Amazon Rekognition.'
      metadata {
        uses 'aws-lambda'
      }
    }
    rekognition = platform 'Amazon Rekognition' {
      description 'Generates machine-learning inference from images.'
      metadata {
        uses 'amazon-rekognition'
      }
    }
    dynamodb = platform 'Amazon DynamoDB' {
      description 'Stores machine-learning inference and associated metadata.'
      metadata {
        uses 'amazon-dynamodb'
      }
      inference = database 'Inference and metadata' {
        description 'Machine-learning results and metadata fetched by the user application.'
      }
    }
    eks = platform 'Amazon Elastic Kubernetes Service' {
      description 'Runs the user and admin applications.'
      metadata {
        uses 'amazon-eks'
      }
      userApp = system 'User application' {
        description 'Consumes live video and stored inference, and exposes the video-feed and inference APIs.'
      }
      adminApp = system 'Admin application' {
        description 'Handles governance, administrative APIs, user APIs, camera onboarding, metrics and insights.'
      }
    }
    apiGateway = platform 'Amazon API Gateway' {
      description 'Exposes APIs for the video feed and machine-learning inference.'
      metadata {
        uses 'amazon-api-gateway'
      }
    }
    cloudwatch = platform 'Amazon CloudWatch' {
      description 'Stores logs and metrics from the complete stack.'
      metadata {
        uses 'amazon-cloudwatch'
      }
    }
    cognito = platform 'Amazon Cognito' {
      description 'Secures the API feed generated by Amazon API Gateway.'
      metadata {
        uses 'amazon-cognito'
      }
    }
  }

  camera -> aws.kinesis 'Publishes live video to'
  aws.kinesis -> aws.s3.images 'Live video is converted into images and sent to'
  aws.s3 -> aws.lambda 'Invokes on an image write event'
  aws.lambda -> aws.rekognition 'Sends the image to'
  aws.rekognition -> aws.dynamodb.inference 'Inference and metadata are stored in'
  aws.eks.userApp -> aws.kinesis 'Consumes the live video feed from'
  aws.eks.userApp -> aws.dynamodb.inference 'Fetches inference from'
  aws.eks.userApp -> aws.apiGateway 'Exposes the video-feed and inference APIs through'
  aws.eks.adminApp -> aws.apiGateway 'Exposes administrative and user APIs through'
  endUser -> aws.eks.userApp 'Consumes the live video and inference APIs'
  aws.cognito -> aws.apiGateway 'Secures the API feed exposed by'
  aws.kinesis -> aws.cloudwatch 'Sends logs and metrics to'
  aws.s3 -> aws.cloudwatch 'Sends logs and metrics to'
  aws.rekognition -> aws.cloudwatch 'Sends logs and metrics to'
  aws.dynamodb -> aws.cloudwatch 'Sends logs and metrics to'
  aws.apiGateway -> aws.cloudwatch 'Sends logs and metrics to'
  aws.cognito -> aws.cloudwatch 'Sends logs and metrics to'
  aws.eks.userApp -> aws.cloudwatch 'Sends logs and metrics to'
  aws.eks.adminApp -> aws.cloudwatch 'Sends logs and metrics to'
  aws.lambda -> aws.cloudwatch 'Sends logs and metrics to'
}

views {
  view index {
    title 'Camera as a Service'
    include *, aws.*
  }
}
