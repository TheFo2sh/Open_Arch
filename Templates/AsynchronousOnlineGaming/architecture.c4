// Asynchronous Online Gaming, after the AWS reference architecture.
// Systems and users are slots. The AWS diagram's network and AZ boundaries are described,
// not modeled as additional element kinds.
model {
  player = user 'Player' {
    description 'Plays the mobile or online game through its backend.'
  }

  aws = zone 'AWS' {
    metadata {
      platform 'aws'
    }

    route53 = platform 'Amazon Route 53' {
      description 'Helps players discover game endpoints and routes by latency or geography.'
      metadata {
        uses 'amazon-route-53'
      }
    }
    autoscaling = platform 'Amazon EC2 Auto Scaling' {
      description 'Runs the game servers in an Auto Scaling group across multiple Availability Zones.'
      metadata {
        uses 'amazon-ec2-auto-scaling'
      }
    }
    cloudfront = platform 'Amazon CloudFront' {
      description 'Provides globally distributed caching for content stored in Amazon S3.'
      metadata {
        uses 'amazon-cloudfront'
      }
    }
    sns = platform 'Amazon Simple Notification Service' {
      description 'Provides push notifications for supported Apple, Google, Amazon, and Windows platforms.'
      metadata {
        uses 'amazon-sns'
      }
    }
    assets = platform 'Amazon S3' {
      description 'Stores game assets, downloadable content, and logs generated by game servers.'
      metadata {
        uses 'amazon-s3'
      }
      gameAssets = database 'Game assets, downloadable content, and server logs'
    }

    vpc = platform 'Amazon VPC' {
      description 'The diagram shows public and private subnets across two Availability Zones.'
      metadata {
        uses 'amazon-vpc'
      }

      internetGateway = platform 'Internet Gateway' {
        description 'Internet connectivity boundary shown for the VPC.'
        metadata {
          uses 'amazon-internet-gateway'
        }
      }
      publicLoadBalancer = platform 'Elastic Load Balancing' {
        description 'Public load balancer for incoming game requests; AWS describes HTTPS termination.'
        metadata {
          uses 'elastic-load-balancing'
        }
      }
      internalLoadBalancer = platform 'Elastic Load Balancing' {
        description 'Internal load balancer shown between the web and application tiers; the text describes this tier split as optional.'
        metadata {
          uses 'elastic-load-balancing'
        }
      }
      natGateways = platform 'Amazon VPC NAT Gateways' {
        description 'NAT gateways shown in the public subnets; exact routing is not specified.'
        metadata {
          uses 'amazon-vpc-nat-gateway'
        }
      }
      s3Endpoint = platform 'Amazon S3 VPC endpoint' {
        description 'Endpoint labeled for S3 in the VPC diagram.'
        metadata {
          uses 'amazon-s3-vpc-endpoint'
        }
      }
      ec2 = platform 'Amazon EC2' {
        description 'Multi-AZ compute for the game backend servers.'
        metadata {
          uses 'amazon-ec2'
        }
        gameBackend = system 'Game backend' {
          description 'The game service, with a web tier in public subnets and an application tier in private subnets.'
          webTier = container 'Web server tier' {
            description 'EC2 web servers shown in public subnets across Availability Zones.'
          }
          appTier = container 'Application server tier' {
            description 'EC2 application servers shown in private subnets across Availability Zones.'
          }
        }
      }
      redis = platform 'Amazon ElastiCache for Redis' {
        description 'Multi-AZ Redis cache shown with a primary and secondary.'
        metadata {
          uses 'amazon-elasticache-redis'
        }
        cache = database 'Redis cache' {
          description 'The diagram shows primary and secondary nodes; AWS also describes read replicas and automated disaster recovery.'
        }
      }
      aurora = platform 'Amazon Aurora' {
        description 'MySQL-compatible relational database.'
        metadata {
          uses 'amazon-aurora'
        }
        gameData = database 'Game database' {
          description 'The diagram shows a main instance and read replicas across Availability Zones; the exact replica count is not prescribed.'
        }
      }
      dynamodb = platform 'Amazon DynamoDB' {
        description 'Managed NoSQL database for predictable performance and scalability.'
        metadata {
          uses 'amazon-dynamodb'
        }
        gameData = database 'NoSQL game data'
      }
    }
  }

  player -> aws.vpc.ec2.gameBackend 'Plays through'
  aws.route53 -> aws.vpc.publicLoadBalancer 'Resolves game service endpoints to'
  aws.vpc.internetGateway -> aws.vpc.publicLoadBalancer 'Provides Internet ingress to'
  aws.autoscaling -> aws.vpc.ec2.gameBackend 'Scales across Availability Zones'
  aws.vpc.publicLoadBalancer -> aws.vpc.ec2.gameBackend.webTier 'Balances incoming requests to'
  aws.vpc.ec2.gameBackend.webTier -> aws.vpc.internalLoadBalancer 'Forwards requests to'
  aws.vpc.internalLoadBalancer -> aws.vpc.ec2.gameBackend.appTier 'Balances internal requests to'
  aws.vpc.ec2.gameBackend.appTier -> aws.vpc.redis.cache 'Uses for caching'
  aws.vpc.ec2.gameBackend.appTier -> aws.vpc.aurora.gameData 'Uses for relational game data'
  aws.vpc.ec2.gameBackend.appTier -> aws.vpc.dynamodb.gameData 'Uses for scalable NoSQL data'
  aws.vpc.ec2.gameBackend.appTier -> aws.vpc.s3Endpoint 'Accesses game objects through'
  aws.vpc.s3Endpoint -> aws.assets.gameAssets 'Connects to'
  aws.cloudfront -> aws.assets.gameAssets 'Caches content from'
  aws.vpc.ec2.gameBackend.appTier -> aws.vpc.natGateways 'Uses the outbound path shown through'
  aws.vpc.natGateways -> aws.vpc.internetGateway 'Uses for Internet egress'
  aws.vpc.ec2.gameBackend.appTier -> aws.sns 'Publishes push notifications through'
}

views {
  view index {
    title 'Asynchronous Online Gaming'
    include *, aws.*, aws.vpc.*, aws.vpc.ec2.*, aws.vpc.ec2.gameBackend.*, aws.vpc.redis.*, aws.vpc.aurora.*, aws.vpc.dynamodb.*, aws.assets.*
  }
}
