// Siemens Industrial Edge on AWS, after the AWS reference architecture.
// Systems are slots that map to the applying project's own systems.
model {
  shopfloor = zone 'Shopfloor' {
    metadata {
      platform 'other'
    }

    industrialEdge = platform 'Siemens Industrial Edge' {
      metadata {
        uses 'siemens-industrial-edge'
      }

      connectors = system 'Industrial protocol connectors' {
        description 'Project-owned connector code for OPC UA, Modbus, SIMATIC S7, EtherNet/IP, and TCP; the reference does not identify connector products.'
        connector = container 'Southbound connector applications' {
          description 'Collects data from industrial assets using the protocol choices shown in the AWS diagram.'
          metadata {
            uses 'opc-ua, modbus, simatic-s7, ethernet-ip, tcp'
          }
        }
      }
      edgeApplications = system 'Industrial Edge applications' {
        description 'Project-owned applications built for the Industrial Edge platform.'
      }
      informationHub = platform 'Industrial Information Hub' {
        description 'Configured Siemens industrial data-layer service.'
        metadata {
          uses 'industrial-information-hub'
        }
      }
      dataBus = platform 'Industrial Edge Databus' {
        description 'Configured Siemens data-bus service for Industrial Edge applications.'
        metadata {
          uses 'industrial-edge-databus'
        }
      }
      sitewiseEdge = platform 'AWS IoT SiteWise Edge' {
        description 'Configured edge software that collects and aggregates industrial data for AWS IoT SiteWise.'
        metadata {
          uses 'aws-iot-sitewise-edge'
        }
      }
      edgeInference = platform 'Siemens AI Inference Server' {
        description 'Configured edge inference runtime for deployed machine-learning models.'
        metadata {
          uses 'siemens-ai-inference-server'
        }
      }
      modelMonitorAgent = platform 'Siemens AI Model Monitor Agent' {
        description 'Configured edge agent that monitors deployed machine-learning models.'
        metadata {
          uses 'siemens-ai-model-monitor-agent'
        }
      }
      mendixEdge = platform 'Mendix on Industrial Edge' {
        description 'Configured Mendix development and deployment platform option for Industrial Edge applications.'
        metadata {
          uses 'mendix'
        }
      }
      flowCreator = platform 'Siemens Flow Creator' {
        description 'Configured Siemens application development platform option for Industrial Edge apps.'
        metadata {
          uses 'flow-creator'
        }
      }
      docker = platform 'Docker' {
        description 'Configured container runtime option for Industrial Edge apps.'
        metadata {
          uses 'docker'
        }
      }
    }

    assets = system 'Industrial assets and data sources' {
      description 'Project system slot for the industrial assets and sources shown in the diagram, such as PLCs, machines, cameras, historians, or MES.'
    }
  }

  enterprise = zone 'Enterprise and edge management' {
    metadata {
      platform 'other'
    }

    edgeManagement = platform 'Siemens Industrial Edge Management' {
      description 'Configured central management software for Industrial Edge devices and applications; hosting location is not specified.'
      metadata {
        uses 'siemens-industrial-edge-management'
      }
    }
    edgeHub = platform 'Siemens Industrial Edge Hub' {
      description 'Configured management and application-distribution capability for Industrial Edge.'
      metadata {
        uses 'siemens-industrial-edge-hub'
      }
    }
    repository = platform 'Global Software and App Repository' {
      description 'Configured repository for Industrial Edge software and applications.'
      metadata {
        uses 'siemens-global-software-app-repository'
      }
    }
    modelManager = platform 'Siemens AI Model Manager' {
      description 'Configured product for deploying and managing machine-learning models on Industrial Edge.'
      metadata {
        uses 'siemens-ai-model-manager'
      }
    }
    modelMonitor = platform 'Siemens AI Model Monitor' {
      description 'Configured product for monitoring machine-learning models on Industrial Edge.'
      metadata {
        uses 'siemens-ai-model-monitor'
      }
    }
  }

  aws = zone 'AWS Cloud' {
    metadata {
      platform 'aws'
    }

    sitewise = platform 'AWS IoT SiteWise' {
      metadata {
        uses 'aws-iot-sitewise'
      }
      industrialData = database 'Industrial asset models and data'
    }
    sitewiseMonitor = platform 'AWS IoT SiteWise Monitor' {
      metadata {
        uses 'aws-iot-sitewise-monitor'
      }
    }
    twinmaker = platform 'AWS IoT TwinMaker' {
      metadata {
        uses 'aws-iot-twinmaker'
      }
    }
    grafana = platform 'Amazon Managed Grafana' {
      metadata {
        uses 'amazon-managed-grafana'
      }
    }
    s3 = platform 'Amazon S3' {
      metadata {
        uses 'amazon-s3'
      }
      coldData = database 'Cold industrial IoT data'
    }
    athena = platform 'Amazon Athena' {
      metadata {
        uses 'amazon-athena'
      }
    }
    quickSight = platform 'Amazon QuickSight' {
      metadata {
        uses 'amazon-quicksight'
      }
    }
    studioLab = platform 'Amazon SageMaker Studio Lab' {
      metadata {
        uses 'amazon-sagemaker-studio-lab'
      }
      modelTraining = system 'Machine-learning model training' {
        description 'Project system slot for model development using data from Amazon S3.'

        modelPackaging = container 'AI model packaging with Siemens AI SDK' {
          metadata {
            uses 'siemens-ai-sdk'
          }
        }
      }
    }
    mendix = platform 'Mendix' {
      description 'Configured Mendix platform for industrial analytics applications.'
      metadata {
        uses 'mendix'
      }
      analyticsApps = system 'Industrial analytics applications' {
        description 'Project-owned analytics applications built and configured on Mendix.'
      }
    }
    visualizationApps = system 'Industrial visualization applications' {
      appKit = container 'Custom IoT visualization applications' {
        metadata {
          uses 'aws-iot-app-kit'
        }
      }
    }
  }

  shopfloor.assets -> shopfloor.industrialEdge.connectors 'Provides industrial data to'
  shopfloor.industrialEdge.connectors -> shopfloor.industrialEdge.sitewiseEdge 'Feeds collected data to'
  shopfloor.industrialEdge.sitewiseEdge -> aws.sitewise.industrialData 'Sends aggregated data to'

  enterprise.edgeManagement -> shopfloor.industrialEdge 'Manages'
  enterprise.repository -> shopfloor.industrialEdge.edgeApplications 'Distributes software and apps to'
  aws.sitewise.industrialData -> aws.s3.coldData 'Delivers cold industrial data to'
  aws.sitewise.industrialData -> aws.sitewiseMonitor 'Provides data for visualization'
  aws.sitewise.industrialData -> aws.twinmaker 'Provides data for digital twins'
  aws.sitewise.industrialData -> aws.grafana 'Provides data for visualization'
  aws.sitewise.industrialData -> aws.visualizationApps 'Provides data to'
  aws.s3.coldData -> aws.athena 'Provides cold data for queries'
  aws.athena -> aws.grafana 'Provides query results to'
  aws.athena -> aws.quickSight 'Provides query results to'
  aws.athena -> aws.mendix.analyticsApps 'Provides query results to'
  aws.s3.coldData -> aws.studioLab.modelTraining 'Provides training data to'
  aws.studioLab.modelTraining.modelPackaging -> enterprise.modelManager 'Delivers packaged models to'
  enterprise.modelManager -> shopfloor.industrialEdge.edgeInference 'Deploys models for'
  enterprise.modelMonitor -> shopfloor.industrialEdge.modelMonitorAgent 'Monitors models through'
  shopfloor.industrialEdge.mendixEdge -> shopfloor.industrialEdge.edgeApplications 'Builds and deploys applications on'
  shopfloor.industrialEdge.flowCreator -> shopfloor.industrialEdge.edgeApplications 'Builds applications on'
  shopfloor.industrialEdge.docker -> shopfloor.industrialEdge.edgeApplications 'Packages and runs applications on'
}
