// Open edX on AWS, after AWS's reference architecture
// (https://docs.aws.amazon.com/reference-architecture-diagrams/latest/open-edx-for-high-availability-on-aws/open-edx-for-high-availability-on-aws.html).
// Read together with the repository's specification.c4. Systems and users are slots.
model {
  student = user 'Student' {
    description 'Uses Open edX courses, learner accounts, and mobile frontends.'
  }
  instructor = user 'Instructor' {
    description 'Uses Open edX teaching and reporting features.'
  }
  administrator = user 'Platform administrator' {
    description 'Manages the Open edX platform through the bastion host.'
  }

  codeRepositories = system 'Open edX code repositories' {
    description 'External source repositories; AWS does not specify their hosting provider.'
    technology 'Open edX code repositories'
  }
  mobileFrontends = system 'Open edX mobile frontends' {
    description 'Slot for the stateless mobile frontend applications served from S3 through CloudFront.'
    frontend = container 'Mobile frontend application' {
      technology 'Open edX'
      metadata {
        uses 'open-edx'
      }
    }
  }

  aws = zone 'AWS' {
    description 'Reference deployment across private subnets and Availability Zones; exact network configuration is not specified.'
    metadata {
      platform 'aws'
    }

    route53 = platform 'Amazon Route 53' {
      description 'Directs students toward nearby CloudFront locations for static content.'
      metadata {
        uses 'amazon-route-53'
      }
    }
    acm = platform 'AWS Certificate Manager' {
      metadata {
        uses 'aws-certificate-manager'
      }
    }
    cloudfront = platform 'Amazon CloudFront' {
      description 'Delivers stateless Open edX mobile frontend assets stored in S3.'
      metadata {
        uses 'amazon-cloudfront'
      }
    }
    alb = platform 'Application Load Balancer' {
      description 'Scales with student traffic, terminates HTTPS, and routes requests to application target groups.'
      metadata {
        uses 'amazon-elastic-load-balancing'
      }
    }
    nat = platform 'Amazon VPC NAT gateway' {
      description 'Provides a path from private subnets to Open edX code repositories.'
      metadata {
        uses 'amazon-nat-gateway'
      }
    }
    networkLoadBalancer = platform 'Network Load Balancer' {
      description 'Selects a target and opens a TCP connection for the MongoDB path.'
      metadata {
        uses 'amazon-network-load-balancer'
      }
    }

    s3 = platform 'Amazon S3' {
      metadata {
        uses 'amazon-s3'
      }
      mobileFrontendAssets = database 'Mobile frontend assets' {
        description 'Stateless Open edX mobile frontend files served through CloudFront.'
      }
      learningAssets = database 'Learning assets and archives' {
        description 'Active learning assets and archived material.'
      }
      serverLogs = database 'Server logs' {
        description 'Log files generated by Open edX servers.'
      }
    }

    ec2 = platform 'Amazon EC2' {
      metadata {
        uses 'amazon-ec2'
      }

      bastion = system 'Bastion host' {
        description 'Administrator entry point for securely managing platform components.'
      }

      autoScaling = platform 'Amazon EC2 Auto Scaling' {
        description 'Runs scalable Open edX application and ProxySQL instances in private subnets.'
        metadata {
          uses 'amazon-ec2-auto-scaling'
        }

        userFacingApps = system 'Open edX user-facing backend apps' {
          description 'Slot for the user-facing CMS, LMS, and Insights application tier.'
          cms = container 'CMS' {
            technology 'Open edX'
            metadata {
              uses 'open-edx'
            }
          }
          lms = container 'LMS' {
            technology 'Open edX'
            metadata {
              uses 'open-edx'
            }
          }
          insights = container 'Insights' {
            technology 'Open edX'
            metadata {
              uses 'open-edx'
            }
          }
        }
        apiServices = system 'Open edX API backend services' {
          description 'Slot for the Notes, Forums, and Blockstore API services.'
          notesContainer = container 'Notes' {
            technology 'Open edX'
            metadata {
              uses 'open-edx'
            }
          }
          forums = container 'Forums' {
            technology 'Open edX'
            metadata {
              uses 'open-edx'
            }
          }
          blockstore = container 'Blockstore' {
            technology 'Open edX'
            metadata {
              uses 'open-edx'
            }
          }
        }
        databaseProxy = system 'Open edX relational database proxy' {
          description 'Slot for the ProxySQL tier that exposes one MySQL-compatible endpoint.'
          proxy = container 'ProxySQL' {
            technology 'ProxySQL'
            metadata {
              uses 'proxysql'
            }
          }
        }
      }

      mongodb = platform 'MongoDB replica set' {
        description 'Self-managed MongoDB database software on EC2.'
        metadata {
          uses 'mongodb'
        }
        openEdxData = database 'Open edX document data' {
          description 'One primary and two secondary nodes; the secondaries provide quorum to elect a new primary after failure.'
        }
      }
    }

    redis = platform 'Amazon ElastiCache for Redis' {
      description 'Managed cache nodes distributed across Availability Zones.'
      metadata {
        uses 'amazon-elasticache-redis'
      }
      cache = database 'Redis cache and transaction state' {
        description 'Open edX cache and transaction state; the source does not assign individual data types to Redis.'
      }
    }
    memcached = platform 'Amazon ElastiCache for Memcached' {
      description 'Managed cache nodes distributed across Availability Zones.'
      metadata {
        uses 'amazon-elasticache-memcached'
      }
      cache = database 'Memcached cache' {
        description 'Open edX cache; the source does not assign individual data types to Memcached.'
      }
    }
    aurora = platform 'Amazon Aurora MySQL' {
      metadata {
        uses 'amazon-aurora-mysql'
      }
      relationalData = database 'Open edX relational data' {
        description 'Relational workloads exposed through Aurora cluster and reader endpoints.'
      }
    }
    opensearch = platform 'Amazon OpenSearch Service' {
      metadata {
        uses 'amazon-opensearch-service'
      }
      searchData = database 'Open edX search data'
    }
    ses = platform 'Amazon Simple Email Service' {
      metadata {
        uses 'amazon-ses'
      }
    }
  }

  student -> mobileFrontends 'Uses'
  instructor -> mobileFrontends 'Uses'
  student -> aws.ec2.autoScaling.userFacingApps 'Accesses'
  instructor -> aws.ec2.autoScaling.userFacingApps 'Accesses'
  mobileFrontends -> aws.cloudfront 'Is delivered through'
  administrator -> aws.ec2.bastion 'Manages platform components through'
  aws.ec2.bastion -> aws.ec2.autoScaling.userFacingApps 'Administers'
  aws.ec2.bastion -> aws.ec2.autoScaling.apiServices 'Administers'
  aws.route53 -> aws.cloudfront 'Directs students to nearby edge locations'
  aws.acm -> aws.cloudfront 'Supplies TLS certificates for'
  aws.acm -> aws.alb 'Supplies TLS certificates for'
  aws.cloudfront -> aws.s3.mobileFrontendAssets 'Retrieves static frontend assets from'
  aws.alb -> aws.ec2.autoScaling.userFacingApps 'Routes HTTPS requests to'
  aws.alb -> aws.ec2.autoScaling.apiServices 'Routes HTTPS requests to'
  aws.nat -> codeRepositories 'Provides private-subnet access to'
  aws.ec2.autoScaling.userFacingApps -> aws.networkLoadBalancer 'Opens TCP connections to MongoDB through'
  aws.ec2.autoScaling.apiServices -> aws.networkLoadBalancer 'Opens TCP connections to MongoDB through'
  aws.networkLoadBalancer -> aws.ec2.mongodb.openEdxData 'Selects a MongoDB target for'
  aws.ec2.autoScaling.userFacingApps -> aws.ec2.autoScaling.databaseProxy.proxy 'Uses the MySQL-compatible endpoint'
  aws.ec2.autoScaling.apiServices -> aws.ec2.autoScaling.databaseProxy.proxy 'Uses the MySQL-compatible endpoint'
  aws.ec2.autoScaling.databaseProxy.proxy -> aws.aurora.relationalData 'Routes writes to the cluster endpoint and reads to the reader endpoint'
  aws.ec2.autoScaling.userFacingApps -> aws.redis.cache 'Uses'
  aws.ec2.autoScaling.apiServices -> aws.redis.cache 'Uses'
  aws.ec2.autoScaling.userFacingApps -> aws.memcached.cache 'Uses'
  aws.ec2.autoScaling.apiServices -> aws.memcached.cache 'Uses'
  aws.ec2.autoScaling.userFacingApps -> aws.opensearch.searchData 'Searches'
  aws.ec2.autoScaling.apiServices -> aws.opensearch.searchData 'Searches'
  aws.ec2.autoScaling.userFacingApps -> aws.s3.learningAssets 'Reads and writes learning assets'
  aws.ec2.autoScaling.apiServices -> aws.s3.learningAssets 'Reads and writes learning assets'
  aws.ec2.autoScaling.userFacingApps -> aws.s3.serverLogs 'Writes server logs to'
  aws.ec2.autoScaling.apiServices -> aws.s3.serverLogs 'Writes server logs to'
  aws.ec2.autoScaling.userFacingApps -> aws.ses 'Sends student email through Open edX SMTP integration'
  aws.ec2.autoScaling.apiServices -> aws.ses 'Sends student email through Open edX SMTP integration'
}

views {
  view index {
    title 'Open edX on AWS'
    include *, aws.*
  }
}
